{
  "name": "kandil-bodrumu",
  "version": "1.0.0",
  "description": "KANDİL BODRUMU — Roguelite tuğla kırıcı oyunu",
  "main": "main.js",
  "author": "AGY",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.agy.kandilbodrumu",
    "productName": "KANDİL BODRUMU",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KANDİL BODRUMU"
    },
    "files": [
      "main.js",
      "src/**/*",
      "icon.ico"
    ]
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
